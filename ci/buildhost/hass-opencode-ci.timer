[Unit]
Description=Detect new hass-opencode commits and trigger CI
Documentation=https://github.com/umrath/hass-opencode/blob/main/ci/buildhost/README.md

[Timer]
# Fast commit detection: shortly after boot, then every minute. The runner's
# per-tick cost when nothing changed is a single `git ls-remote` (no fetch), and
# runs coalesce, so a tight interval is cheap. Persistent so a missed slot (host
# powered off) runs once on the next boot. For instant triggering, a post-push
# step can call run-ci.sh directly (see README) — this timer is the backstop.
OnBootSec=30s
OnUnitActiveSec=1min
Persistent=true
RandomizedDelaySec=5
Unit=hass-opencode-ci.service

[Install]
WantedBy=timers.target
