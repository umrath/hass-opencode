#!/command/with-contenv bashio
export HOME="/data"
export XDG_DATA_HOME="/data/.local/share"
export XDG_CONFIG_HOME="/data/.config"
if [ -f /data/.env_vars ]; then source /data/.env_vars; fi

if [ "$(bashio::config 'mobile_proxy_enabled' || echo 'true')" != "true" ]; then
    exec sleep infinity
fi

TERMINAL_THEME=$(bashio::config 'terminal_theme')
FONT_SIZE=$(bashio::config 'font_size')
CURSOR_STYLE=$(bashio::config 'cursor_style')
CURSOR_BLINK=$(bashio::config 'cursor_blink')

source /etc/profile.d/opencode-theme.sh
THEME_JSON=$(get_theme "${TERMINAL_THEME}")

FONT_SIZE_MOBILE=$((FONT_SIZE + 2))
[ "${FONT_SIZE_MOBILE}" -gt 24 ] && FONT_SIZE_MOBILE=24

exec ttyd -W -p 8097 -i 127.0.0.1 -I /opt/ttyd/index.html \
    -t fontSize="${FONT_SIZE_MOBILE}" \
    -t fontWeight=normal -t fontWeightBold=bold \
    -t letterSpacing=0 -t lineHeight=1.0 \
    -t cursorBlink="${CURSOR_BLINK}" -t cursorStyle="${CURSOR_STYLE}" \
    -t drawBoldTextInBrightColors=true -t minimumContrastRatio=4.5 \
    -t macOptionClickForcesSelection=true -t scrollback=5000 \
    -t "theme=${THEME_JSON}" \
    bash -c "cd /homeassistant && /usr/local/bin/opencode-session.sh"
