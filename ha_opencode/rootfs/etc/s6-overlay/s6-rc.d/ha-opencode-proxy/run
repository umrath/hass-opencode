#!/command/with-contenv bashio
export HOME="/data"
export XDG_DATA_HOME="/data/.local/share"
export XDG_CONFIG_HOME="/data/.config"
if [ -f /data/.env_vars ]; then source /data/.env_vars; fi

if [ "$(bashio::config 'mobile_proxy_enabled' || echo 'true')" != "true" ]; then
    exec sleep infinity
fi

export OC_PROXY_PORT=8099 OC_DESKTOP_PORT=8098 OC_MOBILE_PORT=8097
bashio::log.info "Proxy: binding ingress port 8099"
exec python3 /usr/share/oc-proxy/proxy.py
