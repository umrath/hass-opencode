# Pre-built base image for hass-opencode.
# Contains all slow-to-install dependencies (apt, npm, pip) so the main
# Dockerfile only needs to COPY our source and run fast finalisation steps.
#
# Rebuild when: Debian Trixie base updates, Node 22 updates, opencode-ai updates.
# Rebuild schedule: weekly via cron on the build host.
FROM ghcr.io/home-assistant/base-debian:trixie

ARG BUILD_ARCH
ARG TARGETARCH
ARG TTYD_VERSION=1.7.7
ARG OPENCODE_VERSION=latest
ARG PPQ_PROXY_VERSION=0.1.0
ARG TSX_VERSION=4.20.6

ENV NODE_ENV=production \
    npm_config_update_notifier=false \
    npm_config_fund=false

# ── apt: system packages + Node 22 from nodesource ──────────────────────────
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gnupg \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends \
        git jq nodejs procps python3 python3-venv tmux \
    && rm -rf /var/lib/apt/lists/*

ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# ── ttyd: web terminal (single binary from GitHub) ───────────────────────────
RUN _A="${BUILD_ARCH:-$TARGETARCH}" \
    && ARCH=$(case "$_A" in aarch64|arm64) echo aarch64 ;; *) echo x86_64 ;; esac) \
    && curl -fsSL "https://github.com/tsl0922/ttyd/releases/download/${TTYD_VERSION}/ttyd.${ARCH}" -o /usr/bin/ttyd \
    && chmod +x /usr/bin/ttyd

# ── zigporter: Zigbee toolkit (isolated venv) ────────────────────────────────
RUN python3 -m venv /opt/zigporter-venv \
    && /opt/zigporter-venv/bin/pip install --no-cache-dir zigporter \
    && ln -s /opt/zigporter-venv/bin/zigporter /usr/local/bin/zigporter

# ── npm: opencode-ai + prettier + ppq + tsx ──────────────────────────────────
RUN _A="${BUILD_ARCH:-$TARGETARCH}" \
    && npm config set prefix /usr/local \
    && npm install -g opencode-ai@${OPENCODE_VERSION} --ignore-scripts \
    && cd /usr/local/lib/node_modules/opencode-ai \
    && case "${_A}" in \
         aarch64|arm64) npm install opencode-linux-arm64@${OPENCODE_VERSION} ;; \
         *)             npm install opencode-linux-x64@${OPENCODE_VERSION} ;; \
       esac \
    && npm install -g prettier ppq-private-mode@${PPQ_PROXY_VERSION} tsx@${TSX_VERSION} \
    && npm cache clean --force
